FT_UID=
FT_SECRET=
# Opcionales
# FT_CAMPUS_ID=22
# FT_CURSUS_ID=21
# FT_DATABASE_URL=sqlite:///data/stats42.db

# ---- .env.web (solo la web; otra aplicación de 42, con su propio FT_UID/FT_SECRET y su Redirect URI) ----
# Login con 42 (opcional: sin esto, /auth/login responde 503)
# FT_UID=
# FT_SECRET=
# FT_SESSION_SECRET=      # cadena aleatoria larga:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# FT_BASE_URL=https://42madrid.zelada.es
# Avisos por correo (opcional, solo en .env.web; sin esto no hay avisos y la web no los ofrece). Cualquier SMTP con STARTTLS sirve
# (Brevo, Amazon SES, Resend...). El dominio del remitente debe tener SPF, DKIM y DMARC para no acabar en spam.
# FT_SMTP_HOST=
# FT_SMTP_PORT=587
# FT_SMTP_USER=
# FT_SMTP_PASSWORD=
# FT_MAIL_FROM=42stats <avisos@zelada.es>
# FT_MAIL_REPLY_TO=jose@zelada.es   # opcional: las respuestas de los alumnos llegan aquí en vez de al remitente
# FT_ADMIN_LOGINS=tu_login   # solo estos logins ejecutan el sondeo que compara el token de usuario con el de la app
